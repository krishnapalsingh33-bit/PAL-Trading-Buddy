{
  "name": "trading-discipline-tracker-desktop",
  "version": "2.0.0",
  "private": true,
  "description": "Trading Discipline Tracker desktop application",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.pal.tradingdisciplinetracker",
    "productName": "Trading Discipline Tracker",
    "files": [
      "main.cjs",
      "preload.cjs",
      "storage.cjs",
      "trading-discipline-tracker.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "TradingDisciplineTracker-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
